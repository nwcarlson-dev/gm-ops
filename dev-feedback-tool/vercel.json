{
  "version": 2,
  "functions": {
    "server.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "dev-feedback.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/dev-feedback.html"
    },
    {
      "src": "/dev-feedback.html",
      "dest": "/dev-feedback.html"
    },
    {
      "src": "/api/fix-untitled",
      "dest": "/api/fix-untitled.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    }
  ]
}
